# RS-SDK Configuration
RS_SDK_URL=http://localhost:3000
RS_SDK_WS=ws://localhost:3001

# Bot Configuration
BOT_NAME=your_bot_name
BOT_PASSWORD=your_bot_password
BOT_VIEWER_URL=http://localhost:3000/viewer

# AI API Configuration (Tier-1 Planner — GPT-4 / Claude)
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Orchestrator Configuration
DISPATCH_INTERVAL=500
DASHBOARD_PORT=4000
AGENT_MAX_ACTIONS=30
LOG_LEVEL=info

# Memory store path (default: ./memory.db)
# MEMORY_DB_PATH=/path/to/memory.db
